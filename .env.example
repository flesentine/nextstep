EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-side Supabase client key used by Edge Functions. Prefer sb_publishable_*.
PROJECT_PUBLIC_KEY=
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
USCIS_API_BASE_URL=https://api-int.uscis.gov/case-status
# Sandbox only. Never enable anonymous access with production credentials.
ALLOW_GUEST_SANDBOX=false
# Base64-encoded 32-byte keys. Generate independently; never expose them to Expo.
CASE_ENCRYPTION_KEY=
CASE_FINGERPRINT_KEY=
# Scheduled polling remains off until production USCIS access is granted.
POLLING_ENABLED=false
POLLING_SHARED_SECRET=
USCIS_DAILY_QUOTA=1000
# Sandbox qualification invocation secret. Store only in Supabase Secrets and Vault.
QUALIFICATION_SHARED_SECRET=
